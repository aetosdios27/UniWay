{
  "name": "uniway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app/ next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "dotenv -e .env.local -- ley up",
    "migrate:down": "dotenv -e .env.local -- ley down",
    "db:seed": "dotenv -e .env.local -- bun scripts/seed.ts",
    "db:seed:phase0": "dotenv -e .env.local -- bun scripts/seed-synthetic-phase0.ts",
    "import:campus": "dotenv -e .env.local -- bun scripts/import-campus.ts",
    "validate:spatial": "dotenv -e .env.local -- bun scripts/validate-spatial.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "maplibre-gl": "^6.4.1",
    "next": "^16.3.3",
    "pmtiles": "^4.3.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.3.3",
    "happy-dom": "^20.10.6",
    "ley": "^0.8.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
