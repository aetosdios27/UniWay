# Database — Local Docker (PostGIS)
# Start with: docker compose up -d
DATABASE_URL="postgres://uniway:uniway@localhost:5432/uniway"
PGURL="postgres://uniway:uniway@localhost:5432/uniway"

# Database — Neon (Postgres + PostGIS)
# DATABASE_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/uniway?sslmode=require"
# PGURL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/uniway?sslmode=require"

