# Sentry (add before production deploy)
# NEXT_PUBLIC_SENTRY_DSN=""

# Authentication
AUTH_SECRET="your-32-byte-hex-or-base64-secret"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
